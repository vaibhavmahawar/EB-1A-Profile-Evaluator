{
  "provider": "groq",
  "model": "openai/gpt-oss-20b",
  "prompt_version": "criterion-v3",
  "request_delay_seconds": 5,
  "retry_backoff_seconds": 20,
  "max_retries": 4,
  "rate_limit_max_wait_seconds": 240,
  "timeout_seconds": 60,
  "batch_profile": false,
  "batch_size": 2,
  "uscis_retrieval_top_k": 3,
  "resume_retrieval_top_k": 3,
  "resume_retrieval_min_score": 0.15,
  "evidence_span_top_k": 5,
  "evidence_span_min_score": 0.15,
  "evidence_fast_path": false,
  "retrieval_mode": "hybrid",
  "retrieval_candidate_pool": 10,
  "hybrid_rrf_constant": 60,
  "hybrid_vector_weight": 0.5,
  "hybrid_bm25_weight": 0.5,
  "cache_enabled": true,
  "cache_path": "eval/cache/provider_responses.sqlite3"
}
